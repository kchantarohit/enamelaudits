# --- Required ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Publishable (or anon) key. All DB access additionally requires APP_SECRET.
SUPABASE_KEY=sb_publishable_xxx
# Random string; store only sha256(APP_SECRET) in private.app_secret (see README).
APP_SECRET=
NEXT_PUBLIC_SITE_URL=https://enamelaudits.vercel.app

# --- Stripe ---
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Payment Links (Stripe-hosted Checkout) used when STRIPE_SECRET_KEY is not set
STRIPE_LINK_REPORT=https://buy.stripe.com/...
STRIPE_LINK_MONTHLY=https://buy.stripe.com/...
STRIPE_LINK_ANNUAL=https://buy.stripe.com/...
# Optional: with a secret key, dynamic Checkout Sessions are used instead
STRIPE_SECRET_KEY=
STRIPE_PRICE_REPORT=price_xxx
STRIPE_PRICE_MONTHLY=price_xxx
STRIPE_PRICE_ANNUAL=price_xxx

# --- Jobs & outreach ---
CRON_SECRET=
OUTREACH_TOKEN=

# --- Optional email (SMTP: Gmail app password, Workspace, Resend SMTP, Postmark...) ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Enamel Audits <reports@yourdomain.com>"
OWNER_EMAIL=

# Local testing only: allow auditing localhost/private hosts
# ALLOW_PRIVATE_HOSTS=1
