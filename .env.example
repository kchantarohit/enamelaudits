# =====================================================================
#  Enamel Audits — ZERO-COST configuration (all services free, no domain)
# =====================================================================

# ---- 1. Payments: Stripe (no monthly fee; Stripe only takes a % when you make a sale) ----
# dashboard.stripe.com > Developers > API keys. Start with sk_test_..., switch to sk_live_... when activated.
STRIPE_SECRET_KEY=sk_test_xxx
# Stripe > Developers > Webhooks > endpoint https://<your-site>.netlify.app/api/stripe-webhook > Signing secret
# (locally: printed by `stripe listen --forward-to localhost:3000/api/stripe-webhook`)
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ---- 2. Email delivery: your free Gmail (no domain needed, ~500 emails/day) ----
# Google Account > Security > 2-Step Verification ON > App passwords > create "Enamel Audits"
GMAIL_USER=yourname@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ---- 3. Your free default domain ----
# e.g. https://enamel-audits.netlify.app  (shown in Netlify after the first deploy)
SITE_URL=

# ---- Optional ----
# Lead + sale alerts (defaults to GMAIL_USER)
OWNER_EMAIL=
# Only needed for the HTTP /api/cron endpoint (Vercel or manual trigger). Netlify uses a built-in schedule.
CRON_SECRET=change-me
# Stripe no-code customer portal login link (Settings > Billing > Customer portal) = "cancel anytime"
STRIPE_PORTAL_URL=
# Free Google key: adds a Lighthouse mobile score to paid reports when it finishes within the time budget
PAGESPEED_API_KEY=
# Alternative email provider (needs a verified domain): leave empty to use Gmail
RESEND_API_KEY=
EMAIL_FROM=
# Prices in cents of CURRENCY. Or set STRIPE_PRICE_REPORT / STRIPE_PRICE_MONTHLY / STRIPE_PRICE_ANNUAL to Price IDs.
PRICE_REPORT_CENTS=9700
PRICE_MONTHLY_CENTS=2900
PRICE_ANNUAL_CENTS=29000
CURRENCY=usd
FOUNDING_SPOTS=25
FOUNDING_RECHECK_DAYS=28
MONITOR_INTERVAL_DAYS=30
# Time limits (ms). Netlify free functions stop at 30s, so the audit is capped at 18s.
AUDIT_BUDGET_MS=18000
SWEEP_BUDGET_MS=28000
