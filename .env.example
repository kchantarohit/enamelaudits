# ---- Required for payments ----
# Stripe Dashboard > Developers > API keys. Use sk_test_... first, then sk_live_...
STRIPE_SECRET_KEY=sk_test_xxx
# Stripe Dashboard > Developers > Webhooks > your endpoint > Signing secret
# (locally: printed by `stripe listen --forward-to localhost:3000/api/stripe-webhook`)
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ---- Required for email delivery ----
# https://resend.com > API Keys. Verify your domain so you can send to customers.
RESEND_API_KEY=re_xxx
EMAIL_FROM="Enamel Audits <reports@yourdomain.com>"
# You get a copy of every lead + sale here (optional but recommended)
OWNER_EMAIL=you@example.com

# ---- Required for monthly monitoring ----
# Any long random string: openssl rand -hex 32  (Vercel Cron sends it automatically)
CRON_SECRET=change-me

# ---- Optional ----
# Public URL of the site (defaults to the Vercel production URL / request origin)
SITE_URL=
# Stripe no-code customer portal login link (Settings > Billing > Customer portal) for "cancel anytime"
STRIPE_PORTAL_URL=
# Free key from Google Cloud: adds a real Lighthouse mobile performance score to paid reports
PAGESPEED_API_KEY=
# Prices (cents). Or set STRIPE_PRICE_REPORT / STRIPE_PRICE_MONTHLY / STRIPE_PRICE_ANNUAL to existing Price IDs.
PRICE_REPORT_CENTS=9700
PRICE_MONTHLY_CENTS=2900
PRICE_ANNUAL_CENTS=29000
CURRENCY=usd
FOUNDING_SPOTS=25
FOUNDING_RECHECK_DAYS=28
MONITOR_INTERVAL_DAYS=30
