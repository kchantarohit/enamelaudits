# Copy to outreach/.env (git-ignored) and fill in what you use.
SITE_URL=https://enamelaudits.vercel.app
OUTREACH_TOKEN=            # same value as the OUTREACH_TOKEN env var in Vercel

# find-leads.mjs: Google Cloud > APIs > enable "Places API (New)" > create API key
GOOGLE_PLACES_API_KEY=

# gmail-outreach.mjs: Gmail login (pick one) + your sender identity
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=          # Google Account > Security > 2-Step Verification > App passwords
# GMAIL_CLIENT_ID=           # or Gmail API OAuth2 instead of an app password
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
SENDER_NAME="Your Name from Enamel Audits"
SENDER_ADDRESS="136 Sukhumvit St, Pattaya, Chonburi 20150 Thailand"
REPLY_TO=
OUTREACH_DAILY_LIMIT=15      # per run; the database caps every 24 h at 20

# reddit-finder.mjs (optional, raises rate limits): reddit.com/prefs/apps > "script"
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
