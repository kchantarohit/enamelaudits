# Copy to outreach/.env (git-ignored) and fill in what you use.
SITE_URL=https://enamelaudits.vercel.app
OUTREACH_TOKEN=            # same value as the OUTREACH_TOKEN env var in Vercel

# find-leads.mjs: Google Cloud > APIs > enable "Places API (New)" > create API key
GOOGLE_PLACES_API_KEY=

# cold-email.mjs: any SMTP mailbox. Use a separate sending domain/mailbox if you can.
SENDER_NAME="Your Name"
SENDER_ADDRESS="136 Sukhumvit St, Pattaya, Chonburi 20150 Thailand"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@yourdomain.com
SMTP_PASS=                 # Gmail: an App Password (Google Account > Security > App passwords)
SMTP_FROM=you@yourdomain.com
REPLY_TO=you@yourdomain.com

# x-post.mjs: developer.x.com app with Read+Write; generate user access token + secret
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# reddit-finder.mjs (optional, raises rate limits): reddit.com/prefs/apps > "script"
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
